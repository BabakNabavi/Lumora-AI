# ─────────────────────────────────────────────────────────────────────────────
#  AI INTERIOR STUDIO — environment
#  Copy to `.env` and fill in. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Any PostgreSQL 14+ instance. For zero-install local development run
# `npm run db:server`, which starts an embedded PostgreSQL (PGlite) speaking the
# real wire protocol on port 5433 — this exact URL then works as-is.
# `pgbouncer=true` disables Prisma prepared statements. Required for the embedded
# dev server below (it multiplexes connections like a pooler); also correct for
# PgBouncer, Supabase pooler, Neon pooled endpoints and RDS Proxy. Drop it when
# connecting straight to a dedicated PostgreSQL instance.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/postgres?schema=public&pgbouncer=true"

# ── Auth ─────────────────────────────────────────────────────────────────────
# 32+ random bytes. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-characters"

# Google OAuth (optional — the Google button hides itself when unset).
# https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── AI provider ──────────────────────────────────────────────────────────────
# One of: mock | replicate | openai
# `mock` performs real, deterministic image processing locally (sharp) so the
# full product works with no API key and no network.
AI_PROVIDER="mock"

# Replicate (SDXL img2img / interior-design models)
REPLICATE_API_TOKEN=""
REPLICATE_MODEL_VERSION=""

# OpenAI (gpt-image-1 edits + vision-based design insights)
OPENAI_API_KEY=""
OPENAI_IMAGE_MODEL="gpt-image-1"
OPENAI_VISION_MODEL="gpt-4.1-mini"

# ── Storage ──────────────────────────────────────────────────────────────────
# One of: local | s3
STORAGE_DRIVER="local"

# local driver
STORAGE_LOCAL_DIR="./storage"

# s3 driver (also works with Cloudflare R2, MinIO, Backblaze B2)
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_PUBLIC_URL=""

# ── Billing (architecture is wired, no live payments yet) ────────────────────
# One of: none | stripe
BILLING_PROVIDER="none"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""
